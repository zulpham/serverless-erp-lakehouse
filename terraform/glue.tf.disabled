# ==============================================================================
# 1. IAM ROLE UNTUK AWS GLUE PYSPARK JOB (LEAST PRIVILEGE AUDITED)
# ==============================================================================

resource "aws_iam_role" "glue_job_role" {
  name = "${var.project_name}-glue-transformation-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "glue.amazonaws.com"
        }
      }
    ]
  })
}

# CloudWatch Log Group Eksplisit dengan Retensi 14 Hari (FinOps)
resource "aws_cloudwatch_log_group" "glue_job_logs" {
  name              = "/aws-glue/jobs/${var.project_name}-transformation"
  retention_in_days = 14
}

# Kebijakan Akses Granular: Scoped hanya ke Database & Tabel Proyek Sendiri
resource "aws_iam_policy" "glue_job_policy" {
  name        = "${var.project_name}-glue-transformation-policy"
  description = "Izin granular bagi Glue PySpark untuk membaca S3 Raw, menulis S3 Iceberg, dan mutasi Database Catalog spesifik"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      # Akses S3 Raw Zone (Read-Only)
      {
        Effect = "Allow"
        Action = [
          "s3:GetObject",
          "s3:ListBucket"
        ]
        Resource = [
          aws_s3_bucket.raw_zone.arn,
          "${aws_s3_bucket.raw_zone.arn}/*"
        ]
      },
      # Akses S3 Iceberg Warehouse (Read & Write)
      {
        Effect = "Allow"
        Action = [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject",
          "s3:ListBucket"
        ]
        Resource = [
          aws_s3_bucket.iceberg_warehouse.arn,
          "${aws_s3_bucket.iceberg_warehouse.arn}/*"
        ]
      },
      # Izin Mutasi Metadata Terkunci Khusus ke Database & Tabel Proyek Sendiri
      {
        Effect = "Allow"
        Action = [
          "glue:GetDatabase",
          "glue:GetDatabases",
          "glue:GetTable",
          "glue:GetTables",
          "glue:CreateTable",
          "glue:UpdateTable",
          "glue:DeleteTable",
          "glue:GetPartition",
          "glue:GetPartitions",
          "glue:BatchCreatePartition",
          "glue:BatchGetPartition"
        ]
        Resource = [
          "arn:aws:glue:${var.aws_region}:${data.aws_caller_identity.current.account_id}:catalog",
          "arn:aws:glue:${var.aws_region}:${data.aws_caller_identity.current.account_id}:database/${aws_glue_catalog_database.lakehouse_db.name}",
          "arn:aws:glue:${var.aws_region}:${data.aws_caller_identity.current.account_id}:table/${aws_glue_catalog_database.lakehouse_db.name}/*"
        ]
      },
      # Logging ke CloudWatch Logs Terkunci
      {
        Effect = "Allow"
        Action = [
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ]
        Resource = "${aws_cloudwatch_log_group.glue_job_logs.arn}:*"
      }
    ]
  })
}

resource "aws_iam_role_policy_attachment" "glue_job_attach" {
  role       = aws_iam_role.glue_job_role.name
  policy_arn = aws_iam_policy.glue_job_policy.arn
}

# ==============================================================================
# 2. UPLOAD SKRIP PYSPARK KE S3 ICEBERG (FOLDER SCRIPTS)
# ==============================================================================
resource "aws_s3_object" "glue_script" {
  bucket      = aws_s3_bucket.iceberg_warehouse.id
  key         = "_scripts/glue_transform.py"
  source      = "${path.module}/../src/transformation/glue_transform.py"
  source_hash = filemd5("${path.module}/../src/transformation/glue_transform.py")
}

# ==============================================================================
# 3. AWS GLUE PYSPARK JOB (UPGRADE KE GLUE 5.0 DENGAN FLEX EXECUTION)
# ==============================================================================
resource "aws_glue_job" "lakehouse_transformation" {
  name              = "${var.project_name}-transformation"
  role_arn          = aws_iam_role.glue_job_role.arn
  glue_version      = "5.0" # Apache Spark 3.5 & Python 3.11 (Runtime Modern 2026)
  worker_type       = "G.1X"
  number_of_workers = 2
  execution_class   = "FLEX" # FinOps: Diskon ~35%

  execution_property {
    max_concurrent_runs = 5 # Mendukung eksekusi paralel multi-entitas dari Step Functions
  }

  command {
    name            = "glueetl"
    script_location = "s3://${aws_s3_bucket.iceberg_warehouse.id}/${aws_s3_object.glue_script.key}"
    python_version  = "3"
  }

  default_arguments = {
    "--datalake-formats"                 = "iceberg"
    "--enable-metrics"                   = "true"
    "--enable-continuous-cloudwatch-log" = "true"
    "--job-language"                     = "python"
    "--RAW_BUCKET_NAME"                  = aws_s3_bucket.raw_zone.id
    "--ICEBERG_BUCKET_NAME"              = aws_s3_bucket.iceberg_warehouse.id
    "--GLUE_DATABASE"                    = aws_glue_catalog_database.lakehouse_db.name
    "--conf" = join(" --conf ", [
      "spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions",
      "spark.sql.catalog.glue_catalog=org.apache.iceberg.spark.SparkCatalog",
      "spark.sql.catalog.glue_catalog.catalog-impl=org.apache.iceberg.aws.glue.GlueCatalog",
      "spark.sql.catalog.glue_catalog.warehouse=s3://${aws_s3_bucket.iceberg_warehouse.id}/"
    ])
  }

  timeout = 20
}
